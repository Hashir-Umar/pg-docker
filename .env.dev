# Development instance — safe weak local-only values. See .env.example for docs.

DB_PREFIX=udp-dev

POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-super
POSTGRES_DB=postgres

APP_DB_USER=udp_user
APP_DB_NAME=udp_db
APP_DB_PASSWORD=udp_password_1234

POSTGRES_HOST_PORT=5432
PGBOUNCER_HOST_PORT=6432
POSTGRES_HOST_BIND=127.0.0.1
PGBOUNCER_HOST_BIND=127.0.0.1

PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_AUTH_TYPE=scram-sha-256
PGBOUNCER_MAX_CLIENT_CONN=100
PGBOUNCER_DEFAULT_POOL_SIZE=20
