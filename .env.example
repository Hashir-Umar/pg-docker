# ─────────────────────────────────────────────────────────────────────────
# Template for per-instance config. Copy to .env.dev and/or .env.prod:
#
#   cp .env.example .env.dev     &&  ./create-db.sh dev up
#   cp .env.example .env.prod    &&  ./create-db.sh prod up
#
# Run several instances on one machine by copying to e.g. app-b.prod.env and
# selecting it:  ENV_FILE=./app-b.prod.env ./create-db.sh prod up
#
# RULES:
#   - Keep comments on their OWN line (inline comments can leak into values).
#   - DB_PREFIX and the two host ports MUST be unique per co-located instance.
#   - Use strong, unique passwords in prod.
# ─────────────────────────────────────────────────────────────────────────

# ── Identity ──────────────────────────────────────────────────────────────
# Namespaces project, containers, network and volume. Unique per instance.
DB_PREFIX=myapp

# ── Superuser (bootstrap only — first boot) ───────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-super
POSTGRES_DB=postgres

# ── Application role + database (what the app/pgbouncer use) ───────────────
APP_DB_USER=app
APP_DB_NAME=app
APP_DB_PASSWORD=change-me-app

# ── Host ports & bind address ─────────────────────────────────────────────
# app     -> 127.0.0.1:${PGBOUNCER_HOST_PORT}  (via pgbouncer)
# ddl/GUI -> 127.0.0.1:${POSTGRES_HOST_PORT}   (direct to postgres)
POSTGRES_HOST_PORT=5432
PGBOUNCER_HOST_PORT=6432
# Loopback by default. Only set 0.0.0.0 with TLS in front (see README).
POSTGRES_HOST_BIND=127.0.0.1
PGBOUNCER_HOST_BIND=127.0.0.1

# ── pgbouncer pool ────────────────────────────────────────────────────────
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_AUTH_TYPE=scram-sha-256
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=25
# prod only:
# PGBOUNCER_MIN_POOL_SIZE=5
# PGBOUNCER_RESERVE_POOL_SIZE=5
# PGBOUNCER_MAX_PREPARED_STATEMENTS=200

# ── Image versions (optional) ─────────────────────────────────────────────
# POSTGRES_VERSION=18-alpine
# PGBOUNCER_VERSION=latest

# ═══════════════════════════════════════════════════════════════════════════
# PROD-ONLY KNOBS (ignored by docker-compose.dev.yml)
# ═══════════════════════════════════════════════════════════════════════════

# ── Postgres tuning ───────────────────────────────────────────────────────
# Size to the box. Rules of thumb: shared_buffers ≈ 25% RAM,
# effective_cache_size ≈ 75% RAM. Defaults below assume ~2 GB for postgres.
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_WAL_BUFFERS=16MB
PG_MAX_WAL_SIZE=2GB
PG_MIN_WAL_SIZE=512MB
PG_CHECKPOINT_COMPLETION_TARGET=0.9
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200
PG_SYNCHRONOUS_COMMIT=on

# ── Resource limits ───────────────────────────────────────────────────────
POSTGRES_CPU_LIMIT=2
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_MEMORY_RESERVATION=512m
PGBOUNCER_CPU_LIMIT=1
PGBOUNCER_MEMORY_LIMIT=256m

# ── Backups (pg-backup) ───────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_TZ=UTC
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8
BACKUP_KEEP_MONTHS=12
BACKUP_COMPRESS_LEVEL=6
