# Production instance. REPLACE the passwords before deploying.
# Uses different host ports than dev so both can run on one machine.
# See .env.example for full documentation of every knob.

DB_PREFIX=myapp-prod

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_super_strong
POSTGRES_DB=postgres

APP_DB_USER=app
APP_DB_NAME=app
APP_DB_PASSWORD=CHANGE_ME_app_strong

POSTGRES_HOST_PORT=5544
PGBOUNCER_HOST_PORT=6544
POSTGRES_HOST_BIND=127.0.0.1
PGBOUNCER_HOST_BIND=127.0.0.1

PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_AUTH_TYPE=scram-sha-256
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=25
PGBOUNCER_MIN_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_MAX_PREPARED_STATEMENTS=200

# Postgres tuning — size to the box (~2 GB allotted to postgres here).
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_WAL_BUFFERS=16MB
PG_MAX_WAL_SIZE=2GB
PG_MIN_WAL_SIZE=512MB
PG_CHECKPOINT_COMPLETION_TARGET=0.9
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200
PG_SYNCHRONOUS_COMMIT=on

POSTGRES_CPU_LIMIT=2
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_MEMORY_RESERVATION=512m
PGBOUNCER_CPU_LIMIT=1
PGBOUNCER_MEMORY_LIMIT=256m

BACKUP_DIR=./backups
BACKUP_TZ=UTC
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8
BACKUP_KEEP_MONTHS=12
BACKUP_COMPRESS_LEVEL=6
